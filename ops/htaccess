# ---------------------------------------------------------------- routing ---
# `next build` with output:"export" writes /submission.html, not
# /submission/index.html, so Apache has to be told to serve the former when the
# latter is asked for. The RewriteRule further down does that explicitly.
#
# MultiViews would let Apache pick between submission.html and submission.txt
# for a request to /submission, and the .txt is the React payload, not a page.
# The IfModule guard is not decoration: if the host does not allow `Options` in
# .htaccess the directive is a 500 for the whole site, and this at least skips
# it where mod_negotiation is absent. If you see a 500 the moment you extract,
# comment the next three lines out first.
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

DirectoryIndex index.html

# public/speakers/ holds the speaker photographs, so /speakers is BOTH a page
# and a real directory. Without this, mod_autoindex answers /speakers/ with a
# listing of that directory: the page is unreachable and the file tree is
# published. Nothing here should ever be browsable.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # A request for a file that exists is always that file. This covers every
  # asset, including the photographs under /speakers/.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /submission -> /submission.html, and /submission/ likewise.
  #
  # Deliberately NOT skipped when the path is a directory. /speakers is both a
  # page and a directory of photographs, and the page has to win. Testing for
  # the .html here also has to happen before mod_dir gets the request, or it
  # appends a slash and redirects to the directory before this rule is reached.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# --------------------------------------------------------------- security ---
# These are the headers next.config.ts sets when the app runs under Node. The
# static build has no server to set them, so Apache does it instead. Keep the
# two in step: a change in one is a change in the other.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.isphoa2026.org; frame-src 'self' https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  # The host runs mod_pagespeed, which rewrites markup and was mangling nothing
  # visible here, but it also strips the integrity of the hashed bundles. Off.
  Header always unset X-Mod-Pagespeed
</IfModule>

# ---------------------------------------------------------------- caching ---
<IfModule mod_headers.c>
  # Everything under /_next/static is content-hashed, so it can never go stale.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must revalidate or a redeploy is invisible to anyone who has visited.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
