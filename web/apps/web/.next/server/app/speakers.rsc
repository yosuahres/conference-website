min-h-screen flex-col font-sans","children":[["$","$L8",null,{"wordmark":"ISPhOA","edition":"2026"}],["$","main",null,{"className":"flex flex-1 flex-col","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(public)","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]}],["$","footer",null,{"className":"bg-ink pb-24 pt-5 md:pb-5","children":["$","div",null,{"className":"mx-auto w-full max-w-[1200px] px-6 md:px-10 ","children":["$","p",null,{"className":"text-center text-[0.78rem] text-paper/80","children":"© 2026 ISPhOA. All rights reserved."}]}]}]]}]]}],{"children":["speakers",["$","$1","c",{"children":[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","(public)","children","speakers","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":["__PAGE__",["$","$1","c",{"children":[["$","div",null,{"className":"surface-light bg-mist","children":[["$","$L9",null,{}],["$","div",null,{"className":"mx-auto w-full max-w-[1200px] px-6 md:px-10 py-16 md:py-20","children":[["$","section","Plenary Speaker",{"className":"","children":[["$","h2",null,{"className":"font-display text-[clamp(1.6rem,4vw,2.5rem)] font-semibold uppercase tracking-[-0.02em] text-navy","children":"Plenary Speaker"}],[["$","article","/photos/speakers/plenary/Picture1.jpg",{"id":"brian-yuliarto","className":"scroll-mt-20 xl:scroll-mt-36 mt-12","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/plenary/Picture1.jpg","alt":"Prof. Brian Yuliarto, S.T., M.Eng., Ph.D.","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Brian Yuliarto, S.T., M.Eng., Ph.D."}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"Minister of Higher Education, Science and Technology · Bandung Institute of Technology, Indonesia"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","He is a Professor in advanced functional",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"He is a Professor in advanced functional materials, specialized in nanomaterials and biosensors, from the Bandung Institute of Technology. He graduated in 1999 from the Department of Engineering Physics ITB, and earned his M.Sc. (2002) and Ph.D. (2005) in Quantum Engineering and System Science from the University of Tokyo, Japan. His research focuses on the development of nanotechnology-based sensors for detecting hazardous gases, environmental pollutants, and diagnosing diseases like cancer, hepatitis, and dengue fever. He has authored over 326 publications in international journals indexed by Scopus, with an h-index of 43. He received the Habibie Prize in 2024, a recognition as the top researcher in Nanoscience & Nanotechnology in Indonesia in 2023, and was listed among the world's top 2% of scientists in 2024. He was named the best researcher at ITB in 2021 and received the outstanding lecturer award in Science and Technology at ITB in 2017."}],["$","p","Since 2025, he has been appointed as Min",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"Since 2025, he has been appointed as Minister of Higher Education, Science, and Technology. Previously he served as the Vice Rector of Research and Innovation, as the Dean of the Faculty of Industrial Technology, and as the Head of the Engineering Physics Department of the Bandung Institute of Technology."}]],null]}]]}]]]}],["$","section","Keynote Speakers",{"className":"mt-24 md:mt-28","children":[["$","h2",null,{"className":"font-display text-[clamp(1.6rem,4vw,2.5rem)] font-semibold uppercase tracking-[-0.02em] text-navy","children":"Keynote Speakers"}],[["$","article","/photos/speakers/hatta.jpeg",{"id":"hatta","className":"scroll-mt-20 xl:scroll-mt-36 mt-12","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/hatta.jpeg","alt":"Prof. Agus Muhamad Hatta, S.T., M.Si., Ph.D.","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Agus Muhamad Hatta, S.T., M.Si., Ph.D."}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"Institut Teknologi Sepuluh Nopember · President of the Indonesia Optical Society (InOS)"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Prof. Agus Muhamad Hatta is Professor of",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Prof. Agus Muhamad Hatta is Professor of Engineering Physics at the Institut Teknologi Sepuluh Nopember (ITS), Surabaya, where he currently serves as Vice Rector for Research, Innovation, Collaboration, and Alumni Relations."}],["$","p","He finished his undergraduate (S.T., equ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He finished his undergraduate (S.T., equivalent to B.Eng) and his Master's at ITS, and earned his Ph.D. (2010) from the Photonics Research Centre, Technological University Dublin, Ireland."}],["$","p","As a member of the Photonic Engineering ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"As a member of the Photonic Engineering Laboratory, his research focuses on fiber-optic sensing, integrated optics, optical and photonic sensors, and quantum optics, with numerous contributions to optical fiber sensing technologies and photonic devices. He has published extensively in leading international journals and is widely recognized as one of Indonesia's prominent photonics researchers."}],["$","p","He currently also serves as the Presiden",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He currently also serves as the President of the Indonesia Optical Society (InOS)."}]],null]}]]}],["$","article","/photos/speakers/keynotes/Picture3.jpg",{"id":"ganapathy","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/keynotes/Picture3.jpg","alt":"Prof. Senthil Murugan Ganapathy","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Senthil Murugan Ganapathy"}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"University Southampton, UK"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Prof. Senthil Murugan Ganapathy received",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Prof. Senthil Murugan Ganapathy received his Ph.D. (Photonic Materials) in 2001 from the Indian Institute of Science, Bangalore. He worked as a post-doctoral fellow from 2001 to 2005 at the University of Bordeaux, France, and the Toyota Technological Institute, Japan. He joined the Optoelectronics Research Centre at the University of Southampton in April 2005, where he is currently a Professor and Head of the Integrated Photonic Devices Group, and Deputy Head of School (ORC) for Education. He is also an Adjunct Professor at the Indian Institute of Technology Madras, Chennai, India."}],["$","p","His expertise and research interests ran",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"His expertise and research interests range from photonic materials to photonic systems, with a current focus on Mid-IR/high-contrast materials and devices for biomedical sensing, on-chip spectroscopy, on-chip nanoscopy, environmental monitoring and optical communication applications. He has made pioneering contributions in the field of novel optical micro-resonators."}]],null]}]]}],["$","article","/photos/speakers/keynotes/Picture4.jpg",{"id":"azhar-zam","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/keynotes/Picture4.jpg","alt":"Assoc. Prof. Azhar Zam, Ph.D.","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Assoc. Prof. Azhar Zam, Ph.D."}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"NYU Abu Dhabi, UAE"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Prof. Azhar Zam is an Associate Professo",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Prof. Azhar Zam is an Associate Professor of Bioengineering. He holds a B.S. from the University of Indonesia, an M.Sc. from the University of Luebeck, Germany, and a Ph.D. from Friedrich-Alexander-University Erlangen-Nuremberg, Germany."}],["$","p","Zam's research interests focus on the de",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"Zam's research interests focus on the development of smart devices for medical imaging, diagnostics, and monitoring using novel optical technologies, which include smart laser surgery, optical coherence tomography (OCT), photoacoustics, biomedical spectroscopy, AI-aided optical diagnostics and imaging, optical-based smart biosensors, and miniaturized systems. He has written over 85 peer-reviewed articles and book chapters, and books, and holds several patents."}],["$","p","Before joining NYUAD, Zam was an Assista",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"Before joining NYUAD, Zam was an Assistant Professor in Medical Laser and Optics at the Department of Biomedical Engineering, University of Basel, Switzerland, where he founded the Biomedical Laser and Optics Group (BLOG) and co-established the MIRACLE II flagship project. Prior to that, he held research positions at the University of Waterloo, Waterloo, ON, Canada, the National University of Ireland Galway, Galway, Ireland, the Toronto Metropolitan University (formerly known as Ryerson University), Toronto, ON, Canada, and the University of California at Davis, Davis, CA, USA."}]],null]}]]}],["$","article","/photos/speakers/keynotes/Picture5.jpg",{"id":"kanawade","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/keynotes/Picture5.jpg","alt":"Dr.-Ing. Rajesh Kanawade","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Dr.-Ing. Rajesh Kanawade"}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"CSIR-National Chemical Laboratory, Pune, India"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Dr.-Ing. Rajesh Kanawade is the head of ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Dr.-Ing. Rajesh Kanawade is the head of the Hydrogen Engineering & Photonics Sensor Group, under the Physical and Materials Chemistry Division, CSIR–National Chemical Laboratory (CSIR-NCL), Pune, India. He obtained his M.Sc. in Physics (2006) from Savitribai Phule Pune University and his Doctor of Engineering (Dr.-Ing.) in 2013 from Friedrich-Alexander University Erlangen–Nürnberg, Germany."}],["$","p","His interdisciplinary research integrate",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"His interdisciplinary research integrates optics, photonics, spectroscopy, biomedical imaging, laser instrumentation, Raman spectroscopy, laser-induced breakdown spectroscopy (LIBS), fiber-optic sensing, and optical diagnostics for healthcare and industrial applications. His work has produced important advances in biomedical spectroscopy and laser-based sensing technologies and has been published in leading journals in photonics and biophotonics."}]],null]}]]}],["$","article","/photos/speakers/keynotes/Picture6.jpg",{"id":"chaompluk","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/keynotes/Picture6.jpg","alt":"Assoc. Prof. Dr. Piyasak Chaumpluk","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Assoc. Prof. Dr. Piyasak Chaumpluk"}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"UniversityChulalongkorn, Thailand"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Associate Prof. Dr. Piyasak Chaumpluk is",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Associate Prof. Dr. Piyasak Chaumpluk is currently a faculty member at the Genetics Program, Department of Botany, Faculty of Science, Chulalongkorn University, where he also serves as the Head of the Laboratory of Plant Transgenic Technology and Biosensor. His research integrates plant science and genetics with cutting-edge biosensor technology to address challenges in agriculture and biosciences."}],["$","p","He finished his B.Sc. at Khon Kaen Unive",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He finished his B.Sc. at Khon Kaen University, and earned his Master of Agriculture (Plant Pathology) in 1990 and his Doctor of Agriculture (1996), both from Kyoto University. Prior to his current position, he gained valuable international experience as a Researcher at the Iwate Biotechnology Research Center in Japan, where he worked for three years."}],["$","p","His diverse research interests encompass",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"His diverse research interests encompass lab-on-a-chip technology, DNA aptamers for novel detection methods, bio/nano sensors for nucleic acid detection in agriculture and biosciences, in vitro cultivation of plants, and enhancing the value of local genetic resources through genetic and biochemical analysis."}],["$","p","For his outstanding contributions to sci",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"For his outstanding contributions to science and innovation, he has received several prestigious international honors, including the United Kingdom Leadership Award (Knight Level) in 2019 and the Brussels Eureka Innova Award (Chevalier Level) in 2016."}]],null]}]]}],["$","article","/photos/speakers/keynotes/Picture13.jpg",{"id":"anto-satriyo-nugroho","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/keynotes/Picture13.jpg","alt":"Prof. Dr. Eng. Anto Satriyo Nugroho","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Dr. Eng. Anto Satriyo Nugroho"}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"AI&C RC BRIN, Indonesia"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Prof. Dr. Eng. Anto Satriyo Nugroho is a",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Prof. Dr. Eng. Anto Satriyo Nugroho is a Research Professor in Artificial Intelligence and currently is the Head of Research Center for Artificial Intelligence and Cyber Security of the National Research and Innovation Agency (BRIN)."}],["$","p","He got his B.Eng (1995), M.Eng. (2000), ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He got his B.Eng (1995), M.Eng. (2000), and Dr.Eng. (2003) in Electrical and Computer Engineering, all were from the Nagoya Institute of Technology. His research interests are devoted to biometrics, pattern recognition, and image processing."}],["$","p","He has authored 84 Scopus-indexed papers",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He has authored 84 Scopus-indexed papers, with a current h-index of 12. His Scopus ID is 6701506291 and his ORCID ID is 0000-0002-5457-8786."}]],null]}]]}]]]}],["$","section","Invited Speakers",{"className":"mt-24 md:mt-28","children":[["$","h2",null,{"className":"font-display text-[clamp(1.6rem,4vw,2.5rem)] font-semibold uppercase tracking-[-0.02em] text-navy","children":"Invited Speakers"}],[["$","article","/photos/speakers/retna.jpeg",{"id":"retna-apsari","className":"scroll-mt-20 xl:scroll-mt-36 mt-12","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/retna.jpeg","alt":"Prof. Dr. Retna Apsari, M.Si.","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Dr. Retna Apsari, M.Si."}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"Universitas of Airlangga, Indonesia"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Prof. Retna Apsari graduated in Physics ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Prof. Retna Apsari graduated in Physics (1991) from Brawijaya University, earned her Master in Physics from Gajah Mada University in 1998, and her Ph.D. in Physics (Laser Biooptics) from the University of Airlangga in 2009. She has authored 127 international papers with a current Scopus h-index of 18, and holds several patents related to diabetes detection systems."}],["$","p","Prof. Retna Apsari is currently appointe",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"Prof. Retna Apsari is currently appointed as the Dean of the Faculty of Advanced Technology and Multidisciplinary."}]],null]}]]}],["$","article","/photos/speakers/invited/Picture8.jpg",{"id":"hery-suyanto","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/invited/Picture8.jpg","alt":"Prof. Dr. Hery Suyanto","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Dr. Hery Suyanto"}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"University of Udayana, Indonesia"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Hery Suyanto graduated in Physics from t",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Hery Suyanto graduated in Physics from the Institut Teknologi Sepuluh Nopember Surabaya (ITS) in 1988, and earned his Master and Ph.D. (2003) in Optoelectronics from the Faculty of Optoelectronics and Laser Application, the University of Indonesia, Jakarta, Indonesia. In 2019, he was appointed Professor of Optoelectronics and Laser Application at Udayana University."}],["$","p","He has carried out many collaborative re",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He has carried out many collaborative research works, mostly at the Maju Makmur Mandiri Research Centre (MMM) in Jakarta, related to numerous applications of LIBS. His research interest focuses on LIBS applications on biomaterial samples such as nail, hair and teeth for biomarkers and pedigree analysis in his laboratory. These works have been published in more than 40 articles in international journals, and some of them are also being proposed as patents."}]],null]}]]}],["$","article","/photos/speakers/invited/Picture9.jpg",{"id":"isnaeni","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/invited/Picture9.jpg","alt":"Prof. Dr. Isnaeni, M.Sc.","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Dr. Isnaeni, M.Sc."}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"Research Center for Photonics, BRIN, Indonesia"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Prof. Isnaeni is a Research Professor in",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Prof. Isnaeni is a Research Professor in Optics (since 2024) at the National Research and Innovation Agency (BRIN), Indonesia. He graduated in Physics from IPB University, earned his Master's degree in Physics from the University of Queensland in 2006, and his Ph.D. in Physics from the Korea Advanced Institute of Science and Technology, South Korea (2012)."}],["$","p","His research interests are in quantum do",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"His research interests are in quantum dots, graphene dots and plasmonic nanoparticles, laser spectroscopy, nonlinear optics, metamaterials, and nano-bio-photonics."}],["$","p","He has authored more than 150 internatio",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He has authored more than 150 international publications during 2010–2026, and currently he is the Head of the Research Center for Photonics of the National Research and Innovation Agency (BRIN)."}]],null]}]]}],["$","article","/photos/speakers/invited/Picture11.jpg",{"id":"andri-mahendra","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/invited/Picture11.jpg","alt":"Andri Mahendra, Ph.D.","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Andri Mahendra, Ph.D."}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"Co-Founder and CEO, Nicslab"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Andri Mahendra is the Co-Founder and CEO",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Andri Mahendra is the Co-Founder and CEO of Nicslab, a deep-tech company developing advanced test and measurement solutions for photonic integrated circuits, semiconductors, and emerging computing technologies. He holds a Ph.D. from the University of Sydney, with a research background in electronics, photonics instrumentation, and control systems. Under his leadership, Nicslab has developed high-density multichannel source-measure and photonic testing technologies used by leading research institutions, semiconductor companies, and government laboratories worldwide."}],["$","p","Andri is actively involved in advancing ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"Andri is actively involved in advancing the semiconductor and photonics ecosystem through technology development, intellectual property, industry collaboration, and international partnerships. He has also contributed to discussions and initiatives focused on strengthening Indonesia's semiconductor and deep-tech ecosystem."}]],null]}]]}],["$","article","/photos/speakers/invited/Picture12.jpg",{"id":"ruri-agung-wahyuono","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/invited/Picture12.jpg","alt":"Dr. rer. nat. Ruri Agung Wahyuono","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Dr. rer. nat. Ruri Agung Wahyuono"}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"Institut Teknologi Sepuluh Nopember, Indonesia"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","His academic and research expertise cent",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"His academic and research expertise centers on advanced functional materials, particularly for energy, environmental, and sensing applications. He leads the ENABLE research group working with the Advanced Functional Materials Laboratory (AFML), which recently became a research-based spin-off company from ITS. ENABLE focuses on innovation in sensor and biosensor technology, smart and functional materials, and sustainable energy systems."}],["$","p","He is an Assistant Professor in the Depa",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He is an Assistant Professor in the Department of Engineering Physics at Institut Teknologi Sepuluh Nopember (ITS), with an h-index of 17 and 84 Scopus-indexed publications. He currently serves as the Chair of the Graduate Program in Innovation of System and Technology at the School of Interdisciplinary Management and Technology, ITS."}],["$","p","Beyond his academic and industrial roles",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"Beyond his academic and industrial roles, he is passionate about community development, particularly in integrating renewable energy systems into smart farming and supporting sustainable production processes for small and medium enterprises. Through these efforts, he actively contributes to bridging research, technology innovation, and real-world societal impact, and was recently awarded an encouragement award by the Hitachi Global Foundation Asia."}]],null]}]]}],["$","article","/photos/speakers/invited/Picture10.jpg",{"id":"yulkifli","className":"scroll-mt-20 xl:scroll-mt-36 mt-14 border-t border-line pt-14 md:mt-16 md:pt-16","children":[["$","div",null,{"className":"flex flex-col items-center","children":[["$","div",null,{"className":"relative size-[200px] overflow-hidden rounded-full bg-shell md:size-[240px]","children":["$","$La",null,{"src":"/photos/speakers/invited/Picture10.jpg","alt":"Prof. Dr. Yulkifli, S.Pd., M.Si.","fill":true,"sizes":"240px","className":"object-cover object-top"}]}],["$","h3",null,{"className":"mt-6 text-center font-display text-[clamp(1.2rem,2.5vw,1.55rem)] font-semibold tracking-[-0.02em]","children":"Prof. Dr. Yulkifli, S.Pd., M.Si."}],["$","p",null,{"className":"mt-2 text-center text-[0.9rem] text-subtle","children":"Padang State University, Indonesia"}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-5xl","children":[[["$","p","Prof. Yulkifli graduated in Physics Educ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] ","children":"Prof. Yulkifli graduated in Physics Education from IKIP Padang, and earned his Master (2002) and Ph.D. (2010) in Physics from the Bandung Institute of Technology. His fields of expertise are in sensors and sensor systems, physics of instrumentation, and physics education."}],["$","p","He has published numerous international ",{"className":"hyphens-auto text-justify text-[1.02rem] leading-[1.8] mt-1.5","children":"He has published numerous international research papers in his fields of expertise, with 83 Scopus-indexed papers and an h-index of 9 (Scopus) and 16 (Google Scholar). His Scopus ID is 36005049600 and his ORCID ID is 0000-0002-0909-6227."}]],null]}]]}]]]}]]}]]}],null,["$","$Lb",null,{"children":"$Lc"}]]}],{},null,false]},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","0kLCkrKytIi-MoFFgjvg0",{"children":[["$","$Ld",null,{"children":"$Le"}],["$","$Lf",null,{"children":"$L10"}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]]}],false]],"m":"$undefined","G":["$11","$undefined"],"s":false,"S":true}
