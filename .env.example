# Copy to .env and fill in. Both apps read this one file.
#
#   apps/api  — NestJS, port 3333, owns the database and every business rule
#   apps/web  — Next.js, port 3000, renders the UI and calls the API

# ---------------------------------------------------------------- database ---
# Any Postgres: local, Neon, Supabase, RDS. One database, no read replicas.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conference

# ------------------------------------------------------------------ ports ----
PORT=3333
WEB_APP_URL=http://localhost:3000
# Also the canonical origin for SEO: it feeds metadataBase, every canonical
# link, the sitemap and robots.txt. In production set it to https://isphoa2026.org
# with no trailing slash. It must be present at BUILD time, not just at runtime.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# Appears in email subjects and headers.
CONFERENCE_NAME=ICRST

# -------------------------------------------------------------------- seo ----
# Optional. The token from Search Console -> HTML tag verification, without the
# surrounding markup. Leave empty and no verification meta tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------------ auth -----
# openssl rand -base64 32   (use a different value for each)
JWT_ACCESS_TOKEN_SECRET=replace-me-access
JWT_REFRESH_TOKEN_SECRET=replace-me-refresh
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
# Leave empty in development. In production set to ".your-domain.id" so the
# cookie is shared between the web and api subdomains.
COOKIE_DOMAIN=

# Social login is optional — leave these unset and the API simply omits it.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
GITHUB_AUTH_REDIRECT_URI=http://localhost:3333/api/auth/github/callback

# ----------------------------------------------------------------- email -----
# https://resend.com/api-keys — the sending domain must be verified.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="ICRST <secretariat@your-domain.id>"

# --------------------------------------------------------------- payments ----
# https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
# Set the Payment Notification URL there to:
#   {NEXT_PUBLIC_API_URL}/payments/webhook/midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --------------------------------------------------------- file storage ------
# Any S3-compatible bucket. Leave S3_ENDPOINT empty for AWS S3 itself.
# R2 example: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=conference-submissions
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
