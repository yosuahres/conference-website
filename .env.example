# Copy to .env and fill in. Every value here is read at boot by
# apps/web/src/server/env.ts — a missing one fails the build loudly.

# ---------------------------------------------------------------- database ---
# Any Postgres: local, Neon, Supabase, RDS. One database, no read replicas.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conference

# ------------------------------------------------------------------- app -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------ auth -----
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# ----------------------------------------------------------------- email -----
# https://resend.com/api-keys — the sending domain must be verified.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="ICRST 2026 <secretariat@your-domain.id>"

# --------------------------------------------------------------- payments ----
# https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# Set the Payment Notification URL there to:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --------------------------------------------------------- file storage ------
# Any S3-compatible bucket. Leave S3_ENDPOINT unset for AWS S3 itself.
# R2 example: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=conference-submissions
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------ cron -----
# Optional. If set, /api/cron requires `Authorization: Bearer <value>`.
CRON_SECRET=
